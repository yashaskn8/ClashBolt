[Unit]
Description=ClashBolt loopback API (trusted synthetic lab)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=clashbolt-api
Group=clashbolt-api
WorkingDirectory=/opt/clashbolt
EnvironmentFile=/etc/clashbolt/api.env
ExecStart=/opt/clashbolt/.venv/bin/uvicorn clashbolt.api:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=768M
TasksMax=64
LimitNOFILE=512
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
